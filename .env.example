# ---- Dipakai aplikasi web (aman untuk browser) ----
# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# Publishable key (sb_publishable_...). Legacy anon key juga bisa:
# isi NEXT_PUBLIC_SUPABASE_ANON_KEY sebagai gantinya.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# ---- Server only ----
# Daftar domain email yang boleh login, dipisah koma, mis. "itb.ac.id,students.itb.ac.id".
# KOSONGKAN supaya semua akun Google (termasuk Gmail pribadi) boleh login.
ALLOWED_EMAIL_DOMAINS=

# ---- Hanya untuk script lokal (JANGAN diisi di Vercel) ----
# Seed data dummy. Script menolak jalan jika host bukan localhost.
SEED_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Server Postgres untuk test database & uji konkurensi (script membuat DB sementara sendiri).
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Aplikasi web TIDAK memakai service_role key. Jangan pernah menaruhnya di variabel NEXT_PUBLIC_*.
